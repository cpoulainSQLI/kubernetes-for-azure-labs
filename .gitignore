# Your settings stay on your own computer and on your lab VM.
.env

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Build output of the sample app
sample-app/sample-app
sample-app/sample-app.exe

# Tools used by the checks
__pycache__/

# Terraform working files. The course command keeps them in ~/.aro-k8s, but the checks run terraform init here.
# The state lives in Azure Storage, so a state file here would be a mistake: Git ignores it to keep it private.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# Notes passed from one working session to the next, and the local instructions and working files of a coding agent.
# They stay on the author's computer.
handoff/
CLAUDE.md
CLAUDE.local.md
.claude/
