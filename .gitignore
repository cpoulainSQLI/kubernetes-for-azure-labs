# Your settings stay on your own computer.
.env

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Build output of the sample app
sample-app/sample-app
sample-app/sample-app.exe

# Tools used by the checks
__pycache__/

# Terraform working files of the frozen lab VM path in extras/. A state file here would be a mistake:
# Git ignores it to keep it private.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# Notes passed from one working session to the next, and the local instructions and working files of a coding agent.
# They stay on the author's computer.
handoff/
CLAUDE.md
CLAUDE.local.md
.claude/
