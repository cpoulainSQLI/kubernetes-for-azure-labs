#!/usr/bin/env bash
# The course command of the kit kubernetes-labs, for the course "Containers and Kubernetes".
# It builds the environment of the course and runs every lab in it. On Linux the environment is the machine
# itself. On Windows it is a WSL distribution that course.ps1 builds, and this command runs inside it.
# Run ./course help for the list of commands.
set -euo pipefail

COURSE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/lib.sh
source "${COURSE_DIR}/lib/lib.sh"

# The commands that manage the environment, and those that run the labs. tools/check-kit.py and the checker
# of the website read these two lines. course.ps1 accepts the commands of the environment.
ENV_COMMANDS="up connect status check stop destroy update help"
LAB_COMMANDS="start check break solution clean update help"

usage() {
  cat <<'EOF'
The environment (on Linux, from the kit folder: ./course; in the course's WSL distribution: course):
  course up [--yes]           build the environment, safe to run twice. On Linux it lists what it installs and asks.
  course status               show the tools, the registry and the cluster
  course check                readiness report of the environment. Changes nothing.
  course destroy [--yes]      remove what belongs to the course: the cluster, the registry and its data, the launcher
  course update               update the kit (git pull). Your work in ~/work is kept.
The labs:
  course start NN [--yes]     set up lab NN, or bring it back after a stop, for example: course start 01
  course check NN [--guided | --stage N | --deep | --next]
                              check your work on lab NN. Read-only without --deep.
  course break NN [--diagnose | --restore]
                              put one fault into your finished lab, then find it
  course solution NN [--yes]  copy the reference solution into ~/work, after asking
  course clean NN [--yes]     remove what lab NN created. Your files in ~/work are kept.
On Windows, .\course.ps1 up, connect, status, check, stop, destroy and update run in PowerShell.
EOF
}

# ---------------------------------------------------------------------------
# The environment
# ---------------------------------------------------------------------------

# Brings the clone of the kit up to date with git pull. Your work in ~/work is not part of the kit.
kit_update() {
  require_cmd git "Install Git."
  if ! git -C "$COURSE_DIR" rev-parse --git-dir >/dev/null 2>&1; then
    die "${COURSE_DIR} is not a Git clone, so it cannot be updated. Clone the kit with Git."
  fi
  step "Updating the kit in ${COURSE_DIR}"
  if ! git -C "$COURSE_DIR" pull --ff-only; then
    die "git pull failed. If you changed files of the kit, list them with: git -C \"${COURSE_DIR}\" status"
  fi
  info "Your work in ~/work is not part of the kit and was not touched."
}

# Prints what is missing or at another version than the course pins, one tool per line. Nothing means ready.
tools_to_install() {
  local kind_found kubectl_found
  command -v docker >/dev/null 2>&1 || echo "Docker Engine"
  kind_found="$(kind_version)"
  [[ "$kind_found" == "$PINNED_KIND_VERSION" ]] || echo "kind ${PINNED_KIND_VERSION} (found: ${kind_found:-none})"
  kubectl_found="$(kubectl_version)"
  [[ "$kubectl_found" == "${PINNED_KUBECTL_MINOR}".* ]] || echo "kubectl ${PINNED_KUBECTL_MINOR} (found: ${kubectl_found:-none})"
  local tool
  for tool in git curl jq python3; do
    command -v "$tool" >/dev/null 2>&1 || echo "$tool"
  done
  if command -v python3 >/dev/null 2>&1 && ! python3 -c 'import yaml' 2>/dev/null; then
    echo "the YAML module of Python (python3-yaml)"
  fi
}

# Offers a course launcher in ~/.local/bin on a Linux machine, so that course runs from any folder.
offer_launcher() {
  local current_kit
  if [[ -f "$LAUNCHER_FILE" ]]; then
    current_kit="$(sed -n "s/^${LAUNCHER_TAG} \(.*\)$/\1/p" "$LAUNCHER_FILE" | head -n 1)"
    if [[ "$current_kit" == "$KIT_NAME" ]] && grep -qF "\"${COURSE_DIR}/course\"" "$LAUNCHER_FILE"; then
      info "The course command is on your PATH: ${LAUNCHER_FILE}."
      return 0
    fi
    info "${LAUNCHER_FILE} already exists. It runs the kit ${current_kit:-of unknown name}, not this one (${COURSE_DIR})."
    if ! confirm "Replace it, so that course runs this kit?"; then
      info "Kept as it is. Run ./course from ${COURSE_DIR} instead."
      return 0
    fi
  elif ! confirm "Put a course command in ${LAUNCHER_FILE}, so that course runs from any folder?"; then
    info "No launcher. Run ./course from ${COURSE_DIR}."
    return 0
  fi
  mkdir -p "$(dirname "$LAUNCHER_FILE")"
  printf '#!/usr/bin/env bash\n%s %s\nexec bash "%s/course" "$@"\n' "$LAUNCHER_TAG" "$KIT_NAME" "$COURSE_DIR" >"$LAUNCHER_FILE"
  chmod 0755 "$LAUNCHER_FILE"
  info "Wrote ${LAUNCHER_FILE}."
  case ":${PATH}:" in
    *":${HOME}/.local/bin:"*) ;;
    *) info "${HOME}/.local/bin is not on your PATH yet. Ubuntu adds it at your next login, if the folder exists." ;;
  esac
}

env_up() {
  local arg platform missing
  for arg in "$@"; do
    case "$arg" in
      --yes) ASSUME_YES=1 ;;
      -h | --help)
        usage
        exit 0
        ;;
      *) die "Unknown option: ${arg}. Run: course help" ;;
    esac
  done

  # step: preflight
  platform="$(host_platform)"
  case "$platform" in
    linux) ;;
    macos) info "macOS is not tested yet. course up installs nothing here: it checks the tools and creates the registry." ;;
    *) die "Run course up on Linux or macOS. On Windows, run .\\course.ps1 up in PowerShell." ;;
  esac

  # step: tools
  step "Tools"
  missing="$(tools_to_install)"
  if [[ -z "$missing" ]]; then
    info "Docker, kind ${PINNED_KIND_VERSION} and kubectl ${PINNED_KUBECTL_MINOR} are installed."
  elif [[ "$platform" == "macos" ]]; then
    info "Missing or at another version:"
    printf '  %s\n' "$missing" | sed 's/^  \(.\)/  - \1/'
    die "Install them yourself (Docker Desktop or another Docker engine, kind ${PINNED_KIND_VERSION}, kubectl ${PINNED_KUBECTL_MINOR}), then run ./course up again."
  elif ! command -v apt-get >/dev/null 2>&1; then
    printf '%s\n' "$missing" | sed 's/^/  - /'
    die "course up installs the tools on Ubuntu and Debian only. Install the tools above yourself, then run ./course up again."
  else
    info "Missing or at another version:"
    printf '%s\n' "$missing" | sed 's/^/  - /'
    info "With sudo, course up runs setup/install-tools.sh, which installs on this machine:"
    info "  - Docker Engine from the apt repository of Docker (download.docker.com), and adds you to the docker group,"
    info "  - kubectl ${PINNED_KUBECTL_MINOR} from the apt repository of Kubernetes (pkgs.k8s.io),"
    info "  - kind ${PINNED_KIND_VERSION} from its GitHub release, after checking its checksum, in /usr/local/bin,"
    info "  - git, curl, jq and python3-yaml from Ubuntu, and more inotify watches for kind (/etc/sysctl.d/90-kind.conf)."
    info "course destroy never removes them."
    if ! confirm "Install them now?"; then
      info "Nothing installed. Install them yourself, or run ./course up again."
      exit 0
    fi
    sudo bash "${COURSE_DIR}/setup/install-tools.sh" "$(id -un)"
  fi

  # step: docker-access
  require_docker

  # step: registry
  step "Registry"
  ensure_registry

  # step: launcher
  if [[ "$platform" == "linux" ]] && ! in_course_wsl; then
    step "The course command"
    offer_launcher
  fi

  # step: done
  step "Done"
  info "This run took $(duration_text "$SECONDS")."
  info "Docker Engine $(docker_version), kind $(kind_version), kubectl $(kubectl_version), registry on ${REGISTRY_HOST}."
  if [[ "$platform" == "macos" ]]; then
    info "Remember that macOS is not tested yet. Tell the author what works and what does not."
  fi
  info "Next: the readiness report, then the first lab."
  info "  course check"
  info "  course start 01"
}

# On Linux and macOS the learner is already in the environment, so connect and stop answer with one line.
env_connect() {
  # step: cmd-connect
  if in_course_wsl; then
    info "You are already in the WSL distribution of the course."
  else
    info "You are already in the environment of the course: this machine."
  fi
}

env_stop() {
  # step: stop
  if in_course_wsl; then
    info "You are in the WSL distribution of the course. It stops by itself when its last terminal closes, or from PowerShell with .\\course.ps1 stop."
  else
    info "You are already in the environment of the course, this machine, so there is nothing to stop."
  fi
}

env_status() {
  # step: cmd-status
  local where="this machine" state lab node node_state
  if in_course_wsl; then where="the WSL distribution ${KIT_NAME}"; fi
  info "Environment: ${where}"
  info "Docker Engine: $(docker_version | sed 's/^$/not answering/')"
  info "kind: $(kind_version | sed 's/^$/missing/'), kubectl: $(kubectl_version | sed 's/^$/missing/')"
  state="$(registry_state)"
  info "Registry ${REGISTRY_NAME}: ${state:-missing}, on ${REGISTRY_HOST}"
  if cluster_exists; then
    lab="$(cluster_lab)"
    info "Cluster ${KIND_CLUSTER_NAME}: lab ${lab:-unknown}"
    while read -r node node_state; do
      [[ -n "$node" ]] && info "  ${node}: ${node_state}"
    done <<<"$(cluster_nodes_state)"
    if [[ -n "$lab" ]]; then info "Bring it back after a stop with: course start ${lab}"; fi
  else
    info "Cluster ${KIND_CLUSTER_NAME}: none"
  fi
}

env_destroy() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      --yes) ASSUME_YES=1 ;;
      -h | --help)
        usage
        exit 0
        ;;
      *) die "Unknown option: ${arg}. Run: course help" ;;
    esac
  done
  # step: destroy-confirm
  if in_course_wsl; then
    info "The WSL distribution of the course is removed from Windows, with everything in it: run .\\course.ps1 destroy in PowerShell."
    return 0
  fi
  require_docker
  step "Removing what belongs to the course"
  info "This removes the kind cluster ${KIND_CLUSTER_NAME}, the registry ${REGISTRY_NAME} with its volume ${REGISTRY_VOLUME}"
  info "(the images you pushed are lost), ${STATE_DIR}, and the launcher ${LAUNCHER_FILE} if it runs this kit."
  info "It keeps Docker, kind, kubectl, the images on this machine and your work in ~/work."
  if ! confirm "Remove them?"; then
    info "Nothing removed."
    exit 0
  fi
  # step: destroy
  if cluster_exists; then
    kind delete cluster --name "$KIND_CLUSTER_NAME"
  fi
  if [[ -n "$(registry_state)" ]]; then
    docker rm --force "$REGISTRY_NAME" >/dev/null
    info "Removed the registry ${REGISTRY_NAME}."
  fi
  if docker volume inspect "$REGISTRY_VOLUME" >/dev/null 2>&1; then
    docker volume rm "$REGISTRY_VOLUME" >/dev/null
    info "Removed the volume ${REGISTRY_VOLUME}."
  fi
  rm -rf "$STATE_DIR"
  if [[ -f "$LAUNCHER_FILE" ]] && grep -qx "${LAUNCHER_TAG} ${KIT_NAME}" "$LAUNCHER_FILE"; then
    rm -f "$LAUNCHER_FILE"
    info "Removed the launcher ${LAUNCHER_FILE}."
  fi
  info "Done. course up builds the environment again."
}

# ---------------------------------------------------------------------------
# The labs
# ---------------------------------------------------------------------------

# Prints the folder names of the labs, for example: 01-containers 02-kubernetes-core
lab_names() {
  local dir names=""
  for dir in "${COURSE_DIR}"/labs/*/; do
    dir="${dir%/}"
    names="${names} ${dir##*/}"
  done
  printf '%s' "${names# }"
}

# lab_dir COMMAND NN prints the folder of lab NN. NN can be 1, 01 or the folder name, such as 01-containers.
lab_dir() {
  local command_name="$1" wanted="${2:-}" number dir
  if [[ ! "$wanted" =~ ^[0-9]{1,2}(-[a-z0-9-]+)?$ ]]; then
    die "Give the number of a lab, for example: course ${command_name} 01. The labs are: $(lab_names)"
  fi
  number="${wanted%%-*}"
  number="$(printf '%02d' "$((10#$number))")"
  dir="$(lab_folder "$number")"
  if [[ -z "$dir" ]]; then
    die "No lab ${number} in this kit. The labs are: $(lab_names). A newer kit may have it: course update"
  fi
  printf '%s' "$dir"
}

# run_lab SCRIPT COMMAND NN ARGS... runs one script of a lab with the remaining arguments.
run_lab() {
  local script="$1" command_name="$2" dir
  require_environment
  dir="$(lab_dir "$command_name" "${3:-}")"
  shift 3 || shift $#
  if [[ ! -f "${dir}/${script}" ]]; then
    die "Lab ${dir##*/} has nothing for course ${command_name}."
  fi
  exec bash "${dir}/${script}" "$@"
}

# Copies the reference solution of a lab into ~/work/<lab folder>. Files it replaces are kept in ~/work/.backup.
lab_solution() {
  local dir name source_dir work_dir arg file relative replaced=0 backup
  require_environment
  dir="$(lab_dir solution "${1:-}")"
  shift || true
  for arg in "$@"; do
    case "$arg" in
      --yes) ASSUME_YES=1 ;;
      -h | --help)
        usage
        exit 0
        ;;
      *) die "Unknown option: ${arg}. Run: course help" ;;
    esac
  done
  name="${dir##*/}"
  source_dir="${COURSE_DIR}/solutions/${name}"
  work_dir="${HOME}/work/${name}"
  if [[ ! -d "$source_dir" ]]; then
    die "Lab ${name} has no reference solution."
  fi
  require_lab_started "${name%%-*}" "$work_dir"

  step "Reference solution of lab ${name}"
  info "Try the lab on your own first. The solution is one way to pass the checks, not the only one."
  info "This copies these files into ${work_dir}:"
  while IFS= read -r file; do
    relative="${file#"${source_dir}"/}"
    if [[ -e "${work_dir}/${relative}" ]]; then
      info "  ${relative}, which replaces your own file"
      replaced=$((replaced + 1))
    else
      info "  ${relative}"
    fi
  done < <(find "$source_dir" -type f | sort)
  backup="${HOME}/work/.backup/${name}-$(date +%Y%m%d-%H%M%S)"
  if ((replaced > 0)); then
    info "Your files are copied to ${backup} first."
  fi
  if ! confirm "Copy the reference solution?"; then
    info "Nothing changed."
    exit 0
  fi
  while IFS= read -r file; do
    relative="${file#"${source_dir}"/}"
    if [[ -e "${work_dir}/${relative}" ]]; then
      mkdir -p "$(dirname "${backup}/${relative}")"
      cp -p "${work_dir}/${relative}" "${backup}/${relative}"
    fi
    mkdir -p "$(dirname "${work_dir}/${relative}")"
    cp "$file" "${work_dir}/${relative}"
  done < <(find "$source_dir" -type f | sort)
  info "Done. The solution page of the course explains each choice and gives the commands in order."
  info "Check the result with: course check ${name%%-*}"
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

if [[ "$#" -eq 0 ]]; then
  set -- help
fi
command_name="$1"
shift
info "${COURSE_NAME}, lab kit ${KIT_NAME}"

if [[ "$(host_platform)" == "windows" ]]; then
  case "$command_name" in
    help | -h | --help) usage ;;
    up | connect | status | check | stop | destroy | update)
      die "On Windows, run .\\course.ps1 ${command_name} in PowerShell, from the kit folder."
      ;;
    *) die "On Windows, the labs run in the WSL distribution of the course. Open it with .\\course.ps1 connect, then run course ${command_name} there." ;;
  esac
  exit 0
fi

case "$command_name" in
  up) env_up "$@" ;;
  connect) env_connect ;;
  status) env_status ;;
  check)
    if [[ "$#" -eq 0 || "${1:-}" == -* ]]; then
      # step: cmd-check
      exec bash "${COURSE_DIR}/setup/check.sh" "$@"
    fi
    run_lab validate.sh check "$@"
    ;;
  stop) env_stop ;;
  destroy) env_destroy "$@" ;;
  update)
    # step: update-kit
    kit_update
    ;;
  start) run_lab setup.sh start "$@" ;;
  break) run_lab break.sh break "$@" ;;
  clean) run_lab teardown.sh clean "$@" ;;
  solution) lab_solution "$@" ;;
  help | -h | --help) usage ;;
  *)
    usage
    die "Unknown command: ${command_name}. The commands are: ${ENV_COMMANDS} ${LAB_COMMANDS}"
    ;;
esac
