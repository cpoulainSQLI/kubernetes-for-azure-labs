# Scripts and config files must keep Unix line endings, even on Windows,
# because they run on the Linux lab VM.
* text=auto
*.sh text eol=lf
*.tf text eol=lf
*.hcl text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.go text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ps1 text eol=lf
*.psd1 text eol=lf
*.png binary
.env* text eol=lf
Dockerfile text eol=lf
