# Optional settings of the course command. Copy this file to .env, in the kit folder, only to change one.
# The course runs without .env. Nothing in this file is secret. Never put a password, key or token here.
# Format: KEY=value, one per line, no spaces around the equals sign.

# Windows only. The distribution that course.ps1 up copies for the course, as wsl --list --online names it.
WSL_SOURCE=Ubuntu-26.04

# Windows only. The Git URL that the WSL distribution clones the kit from, in HTTPS form.
# Empty means the URL of your own clone (git remote get-url origin), converted to HTTPS.
# The distribution clones without credentials, so a fork must be public.
KIT_REPO=
