# Course settings. Copy this file to .env and fill it in.
# Nothing in this file is secret. Never put a password, key or token here.
# Format: KEY=value, one per line, no spaces around the equals sign.

# Short name used in every Azure resource name: 3 to 12 lowercase letters or digits.
PREFIX=arok8s

# Azure region for every lab. Chapter 0 checks that it offers the VM size, AKS and ARO.
REGION=swedencentral

# Optional: subscription name or ID. Scripts stop if the Azure CLI points at another one.
AZURE_SUBSCRIPTION=

# Currency used for price lookups and shown next to the budget.
CURRENCY=EUR

# Monthly budget for the whole subscription, in your billing currency.
BUDGET_AMOUNT=30

# Optional: where budget alerts go. Empty means the account you sign in with.
BUDGET_CONTACT_EMAIL=

# Your public IPv4 address. Only this address can reach the lab VM over SSH.
# Find it with a "what is my IP" service, then write it here without /32.
LEARNER_IP=

# SSH private key created in chapter 0. The public key is the same path plus .pub.
SSH_KEY_PATH=~/.ssh/aro-k8s-lab

# Lab VM settings. Change them only if chapter 0 tells you to.
ADMIN_USERNAME=azureuser
VM_SIZE=Standard_D2as_v5
VM_IMAGE=Canonical:ubuntu-26_04-lts:server:latest
OS_DISK_GB=64

# Daily automatic shutdown of the lab VM, in hhmm format, and its Windows time zone ID.
AUTO_SHUTDOWN_TIME=1900
AUTO_SHUTDOWN_TIMEZONE=UTC
